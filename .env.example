# Copy this file to .env and fill in your own values. Never commit .env.

# Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# A Gemini model your key can access. Model names change often, so check AI Studio.
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: Langfuse tracing. Copy the exact variable lines shown in your
# Langfuse project settings (including the host or base URL for your region).
# Leave these out to run without tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
